<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pawan.switchprep-ui</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/pawan/Desktop/switch-prep/ui/app.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/pawan/Desktop/switch-prep/ui</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>UI_HOST</key>
        <string>127.0.0.1</string>
        <key>UI_PORT</key>
        <string>5001</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/pawan/Library/Logs/switchprep-ui.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pawan/Library/Logs/switchprep-ui.log</string>
</dict>
</plist>
